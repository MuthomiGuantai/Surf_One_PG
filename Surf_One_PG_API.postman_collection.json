    {
      "name": "Webhooks",
      "item": [
        {
          "name": "KopoKopo Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-KopoKopo-Signature",
                "value": "{{kopokopo_signature}}",
                "type": "text",
                "description": "HMAC signature for webhook validation"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_20260730_001234\",\n  \"topic\": \"buygoods_transaction_received\",\n  \"created_at\": \"2026-07-30T06:45:00Z\",\n  \"data\": {\n    \"reference\": \"TXN-20260730-001234\",\n    \"amount\": 49.00,\n    \"currency\": \"KES\",\n    \"sender\": {\n      \"phone_number\": \"0712345678\"\n    },\n    \"metadata\": {\n      \"merchant_reference\": \"TXN-20260730-001234\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/webhooks/kopokopo",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "webhooks",
                "kopokopo"
