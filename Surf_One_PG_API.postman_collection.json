        {
          "name": "Get Payment Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/payments/{{merchantReference}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "payments",
                "{{merchantReference}}"
              ]
            },
            "description": "Retrieves the current status of a payment transaction. This endpoint is polled by the captive portal every couple of seconds while waiting for the webhook confirmation.\n\n**Path Parameters:**\n- `merchantReference` (required): The transaction reference returned from the initiate payment endpoint\n\n**Response:**\n- `merchantReference`: Transaction identifier\n- `status`: Current status (PENDING, RECEIVED, PROVISIONED, FAILED, EXPIRED)\n- `radiusUsername`: WiFi username (provided when status is PROVISIONED)\n- `radiusPassword`: WiFi password (provided when status is PROVISIONED)\n- `message`: Status description"
          },
          "response": [
            {
              "name": "Pending Payment",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json",
