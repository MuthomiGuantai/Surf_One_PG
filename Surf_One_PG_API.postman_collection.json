    {
      "name": "Webhooks",
      "item": [
        {
          "name": "KopoKopo Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-KopoKopo-Signature",
                "value": "{{kopokopo_signature}}",
                "type": "text",
                "description": "HMAC signature for webhook validation"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"evt_20260730_001234\",\n  \"topic\": \"buygoods_transaction_received\",\n  \"created_at\": \"2026-07-30T06:45:00Z\",\n  \"data\": {\n    \"reference\": \"TXN-20260730-001234\",\n    \"amount\": 49.00,\n    \"currency\": \"KES\",\n    \"sender\": {\n      \"phone_number\": \"0712345678\"\n    },\n    \"metadata\": {\n      \"merchant_reference\": \"TXN-20260730-001234\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/webhooks/kopokopo",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "webhooks",
                "kopokopo"
              ]
            },
            "description": "Webhook endpoint that receives payment callbacks from KopoKopo after customers complete M-Pesa transactions.\n\n**Headers:**\n- `X-KopoKopo-Signature` (required): HMAC-SHA256 signature for request validation\n\n**Body:**\n- `id`: Event ID from KopoKopo\n- `topic`: Event type (buygoods_transaction_received or incoming_payment)\n- `created_at`: Timestamp when event occurred\n- `data`: Transaction details including amount, reference, and sender info\n\n**Note:** This endpoint validates the incoming request signature before processing to ensure authenticity."
          },
          "response": [
            {
              "name": "Success",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  },
                  {
                    "key": "X-KopoKopo-Signature",
                    "value": "valid_signature_here",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"id\": \"evt_20260730_001234\",\n  \"topic\": \"buygoods_transaction_received\",\n  \"created_at\": \"2026-07-30T06:45:00Z\",\n  \"data\": {\n    \"reference\": \"TXN-20260730-001234\",\n    \"amount\": 49.00,\n    \"currency\": \"KES\",\n    \"sender\": {\n      \"phone_number\": \"0712345678\"\n    },\n    \"metadata\": {\n      \"merchant_reference\": \"TXN-20260730-001234\"\n    }\n  }\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/webhooks/kopokopo",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "webhooks",
                    "kopokopo"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"status\": \"success\",\n  \"message\": \"Webhook processed successfully\"\n}\n"
            },
            {
              "name": "Unauthorized (Invalid Signature)",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  },
                  {
                    "key": "X-KopoKopo-Signature",
                    "value": "invalid_signature",
                    "type": "text"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"id\": \"evt_20260730_001234\",\n  \"topic\": \"buygoods_transaction_received\",\n  \"created_at\": \"2026-07-30T06:45:00Z\",\n  \"data\": {\n    \"reference\": \"TXN-20260730-001234\",\n    \"amount\": 49.00,\n    \"currency\": \"KES\",\n    \"sender\": {\n      \"phone_number\": \"0712345678\"\n    },\n    \"metadata\": {\n      \"merchant_reference\": \"TXN-20260730-001234\"\n    }\n  }\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/webhooks/kopokopo",
                  "host": [
                    "{{base_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "webhooks",
                    "kopokopo"
                  ]
                }
