                }
              },
              "status": "Bad Gateway",
              "code": 502,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"merchantReference\": \"TXN-20260730-001235\",\n  \"status\": \"FAILED\",\n  \"message\": \"Could not initiate STK push. Please try again.\"\n}\n"
